<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Codekaro Todos</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
<div class=" mt-4 max-w-5xl mx-auto flex justify-between items-center">
    <a  href="/" class="font-bold text-xl">Todoist</a>
    <a href="" class="text-sm border border-neutral-200 p-2 rounded">Completed tasks</a>
</div>
    <div class="max-w-xl mx-auto mt-12 ">
        <%todos.forEach(todo =>{%>
            <div class="border p-3 border-neutral-200 mt-3 flex gap-4 items-center">
                <h1><%= todo.title %></h1>
                
            </div>
        <%})%>
    </div>

    
    
        
    
